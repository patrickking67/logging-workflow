{
	"name": "logging-workflow",
	"private": true,
	"license": "MIT",
	"description": "Run a Cloudflare Workflow and watch each step get logged live over a WebSocket from a Durable Object",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"check": "npm run lint && npm run typecheck && npm test && npm run build && wrangler deploy --dry-run",
		"lint": "eslint . --max-warnings 0",
		"typecheck": "tsc -b",
		"preview": "npm run build && vite preview",
		"deploy": "npm run build && wrangler deploy",
		"cf-typegen": "wrangler types",
		"test": "vitest run --exclude test/workflow.test.ts && vitest run test/workflow.test.ts"
	},
	"dependencies": {
		"react": "^19.3.1",
		"react-dom": "^19.3.1"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.67.0",
		"@cloudflare/vitest-pool-workers": "^0.10.14",
		"@eslint/js": "^9.33.0",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react-swc": "^4.3.3",
		"autoprefixer": "^10.6.2",
		"eslint": "^9.33.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.7",
		"globals": "^16.3.0",
		"postcss": "^8.5.32",
		"tailwindcss": "^3.4.18",
		"typescript": "~5.8.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^7.1.2",
		"vitest": "3.2.x",
		"wrangler": "^4.51.0"
	}
}
